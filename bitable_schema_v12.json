{
  "version": "v1.2",
  "fields": [
    {
      "name": "REQ ID",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "需求唯一主键。"
    },
    {
      "name": "需求名称",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "需求标题。"
    },
    {
      "name": "项目代号",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "需求所属项目。"
    },
    {
      "name": "需求简述",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "创建需求时的简要背景。"
    },
    {
      "name": "状态",
      "field_type": "single_select",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "options": [
        "CREATED",
        "DRAFTING",
        "AI_REVIEW",
        "HUMAN_CONFIRM",
        "FINAL_REVIEW",
        "APPROVED"
      ],
      "description": "需求层状态机主状态（6 态）。规格层子状态不写入此列。"
    },
    {
      "name": "Spec 阶段",
      "field_type": "single_select",
      "required": false,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "options": [
        "SPEC_DRAFTING",
        "SPEC_LOCKED"
      ],
      "description": "规格层子状态机当前状态。未进入规格层时为空。"
    },
    {
      "name": "当前阶段",
      "field_type": "single_select",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "options": [
        "需求构造",
        "AI Review",
        "人工确认",
        "正式审查",
        "需求已批准",
        "Spec 撰写",
        "Spec 已锁定"
      ],
      "description": "面向人的当前阶段展示。"
    },
    {
      "name": "当前轮次",
      "field_type": "number",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "当前需求构造或 review 的轮次。"
    },
    {
      "name": "当前讨论字段",
      "field_type": "single_select",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "options": [
        "问题描述",
        "使用场景",
        "输入",
        "输出",
        "边界",
        "验收标准",
        "非功能要求",
        "技术范围声明"
      ],
      "description": "当前聚焦的讨论字段，取值来自 DISCUSSION_FIELDS。"
    },
    {
      "name": "当前Owner",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "当前流程接手者。"
    },
    {
      "name": "当前接手角色",
      "field_type": "single_select",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "options": [
        "需求协调服务",
        "需求构造Agent",
        "需求审查Agent",
        "人工确认",
        "正式审查",
        "Spec 撰写 Agent"
      ],
      "description": "当前接手角色的人类可读标签。"
    },
    {
      "name": "已完成字段",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "已完成字段的 JSON 数组字符串。"
    },
    {
      "name": "待补字段",
      "field_type": "text",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "待补字段的 JSON 数组字符串。"
    },
    {
      "name": "最近一次提问",
      "field_type": "text",
      "required": false,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "当前轮对用户的最新追问。"
    },
    {
      "name": "最近一次review结论",
      "field_type": "text",
      "required": false,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "最近一次 review 的摘要结论。"
    },
    {
      "name": "AI Ready",
      "field_type": "checkbox",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "是否达到人工确认门槛。"
    },
    {
      "name": "Human Confirmed",
      "field_type": "checkbox",
      "required": true,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "人工确认是否已通过。"
    },
    {
      "name": "需求文档链接",
      "field_type": "url",
      "required": false,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "需求文档的唯一复用链接。"
    },
    {
      "name": "最近一次写回时间",
      "field_type": "datetime",
      "required": false,
      "writer": "coordinator",
      "readers": ["author", "reviewer", "ops"],
      "description": "Coordinator 最近一次成功写回状态的时间戳（毫秒）。"
    }
  ]
}
